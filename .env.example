# ------------------------------------------------------------
# LLM provider keys
# ------------------------------------------------------------
# Cheap Gemini model (recommended default):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# OpenRouter free models:
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_FREE_1=google/gemma-3-27b-it:free
OPENROUTER_MODEL_FREE_2=qwen/qwen3-32b:free

# Optional OpenRouter ranking metadata (recommended):
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_NAME=LiteCode

# App default model (one of: gemini-cheap | openrouter-free-1 | openrouter-free-2)
LITECODE_DEFAULT_MODEL=openrouter-free-1

# ------------------------------------------------------------
# Supabase (optional, but required for auth/storage/billing in production)
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LITECODE_STORAGE_BUCKET=litecode-artifacts

# Client-side Supabase vars (same values as SUPABASE_URL / SUPABASE_ANON_KEY):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# Plans and daily limits
# ------------------------------------------------------------
LITECODE_DEFAULT_PLAN=free
LITECODE_FREE_DAILY_CHAT_LIMIT=100
LITECODE_FREE_DAILY_ENHANCER_LIMIT=60
LITECODE_PRO_DAILY_CHAT_LIMIT=800
LITECODE_PRO_DAILY_ENHANCER_LIMIT=300

# ------------------------------------------------------------
# App/debug flags
# ------------------------------------------------------------
# trace | debug | info | warn | error
VITE_LOG_LEVEL=info

# Set to 1 to disable IndexedDB chat persistence in browser.
VITE_DISABLE_PERSISTENCE=0

# Streaming mode control:
# - unset: auto (currently defaults to non-stream for Gemini/OpenRouter stability)
# - 1: force non-stream
# - 0: force streaming
LITECODE_FORCE_NON_STREAM=1

# Set to 1 to expose internal stream/provider errors in API chat output.
# Keep 0 in production.
LITECODE_EXPOSE_STREAM_ERRORS=0
